rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper: is the requesting user an administrator?
    // Reads their OWN users doc to check role — this is what makes the
    // AdminPage gate (and role-change protection below) actually enforced
    // server-side, not just hidden in the UI.
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "administrator";
    }
    // Matches AuthContext.jsx's isManager: role === "manager" || "administrator"
    function isManager() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["manager", "administrator"];
    }
    function isSignedIn() {
      return request.auth != null;
    }
    // ── NEW — org-admin role (August 2026, TODO #1) ───────────────────────
    // Independent boolean flag on users/{uid}, deliberately never tied to
    // `role` — an org admin is never a Manager and never gains any of
    // Manager's coalition-wide capabilities (candidates, storms,
    // announcements, etc.). Scope is strictly: manage membership of their
    // OWN org's plain members (add via invite, remove via disable — never
    // real deletion, never another org admin/Manager/Administrator's
    // account). Enforced below on users/{uid}'s update rule; the
    // corresponding Netlify functions (manage-user.mjs, send-invite.mjs)
    // enforce the identical boundary server-side for the actions that go
    // through the Admin SDK and bypass these rules entirely — same
    // two-independent-enforcement-points reasoning as grant-credits.mjs.
    function isOrgAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgAdmin == true;
    }
    // ── NEW — org identity (August 2026) ─────────────────────────────────
    // Matches AuthContext.jsx's future orgId reads: checked via a
    // Firestore doc lookup, the exact same pattern as isAdmin()/isManager()
    // above — deliberately NOT a Firebase custom claim, so there's only
    // one mechanism for "check something about the requesting user" in
    // this whole rules file, not two. Returns false (not an error) for a
    // signed-out user or a user doc with no orgId yet, so callers can use
    // this directly in a boolean expression without a separate isSignedIn()
    // guard every time.
    function isSameOrg(orgId) {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId == orgId;
    }
    // Returns the REQUESTING user's own orgId (or null if signed out, no
    // user doc, or no org assigned yet). Unlike isSameOrg() above (which
    // answers a yes/no question against a GIVEN orgId), this returns the
    // value itself — needed below to check "did this Manager only toggle
    // their OWN org's membership" on an array field like focusOrgIds,
    // where the thing being validated isn't a single org but a diff.
    function myOrgId() {
      return request.auth != null && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.orgId
        : null;
    }
    // candidates/{candidateId}'s focusOrgIds is a many-to-many array (one
    // candidate can be on multiple orgs' priority lists at once — see
    // that match block below). A Manager may add or remove ONLY their own
    // org from that array; they must never be able to add or remove a
    // DIFFERENT org's membership, which would let one org silently
    // hijack or clear another org's priority list. Compares the old and
    // new arrays: every entry that changed (added or removed) must be
    // exactly the requester's own org. Vacuously true if focusOrgIds
    // isn't part of this write at all, or is unchanged.
    function focusOrgIdsChangeIsOwnOrgOnly() {
      let oldIds = ("focusOrgIds" in resource.data) ? resource.data.focusOrgIds : [];
      let newIds = ("focusOrgIds" in request.resource.data) ? request.resource.data.focusOrgIds : [];
      return oldIds.removeAll(newIds).hasOnly([myOrgId()])
          && newIds.removeAll(oldIds).hasOnly([myOrgId()]);
    }
    // Fields on users/{uid} that only an admin may change. The owner can
    // still edit their own profile (name, handles, org, etc.), but never
    // their own role, and never the server-computed rate-limit bookkeeping
    // fields. Without this, a signed-in user could write directly to their
    // own Firestore doc (bypassing the Netlify functions and
    // rateLimitHelper.mjs entirely) and set dailyLimitOverride /
    // dailyLimitOverrideDate to grant themselves unlimited AI calls, or
    // reset dailyCalls / dailyCallsDate early. Fixed July 2026 security pass.
    //
    // orgId added to this list (August 2026) for the same reason role is
    // here: a user assigning themselves into a different org would give
    // them that org's addons/credits/data access for free. Org assignment
    // now only ever happens via scripts/migrate-users-to-orgs.mjs (Admin
    // SDK, bypasses these rules), a direct Firestore edit, or the
    // Admin-panel orgId editor added below — never a self-service profile
    // edit.
    //
    // dailyLimitStanding added (August 2026, alongside the Admin-panel
    // orgId editor) — a PERSISTENT addition to a user's role-based daily
    // call limit, distinct from dailyLimitOverride/dailyLimitOverrideDate
    // above (which is deliberately same-day-only and already protected).
    // Same reasoning as every other field in this list: a user granting
    // themselves a permanently higher limit by writing directly to their
    // own doc would bypass rateLimitHelper.mjs's whole point. Only an
    // Administrator may set it, via the Admin-panel edit-user form.
    // orgAdmin added (August 2026, alongside the org-admin role) — same
    // reasoning as role/orgId: a user granting themselves this flag would
    // let them manage other members of their org without ever being made
    // an actual Administrator. Only a global Administrator may set it (see
    // the update rule below — the new org-admin branch is explicitly
    // barred from touching this field, same as role/orgId/dailyLimit*).
    function ownerProtectedFieldsUnchanged() {
      let protectedFields = ['role', 'orgId', 'orgAdmin', 'dailyCalls', 'dailyCallsDate', 'dailyLimitOverride', 'dailyLimitOverrideDate', 'dailyLimitStanding'];
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(protectedFields);
    }
    // Requires the create to reference a real waitlist doc, in status
    // "invited", whose email matches the account being created. Added this
    // session — this is the actual security boundary for "only approved
    // users get in." See the long comment on users/{uid}'s create rule
    // below for why this was necessary and what it closes.
    function referencesValidInvite() {
      let wl = get(/databases/$(database)/documents/waitlist/$(request.resource.data.waitlistId));
      return request.resource.data.waitlistId is string
        && wl.data.status == "invited"
        && wl.data.email == request.resource.data.email;
    }
    // Manager role-change scope (Aug 26 2026) — deliberately narrow: a
    // Manager may change another user's role only between "user" and
    // "manager", only within their own org, and never touches an existing
    // Administrator's doc at all (can't demote one) nor promotes anyone TO
    // Administrator. Real per-org confirmation the person gave directly:
    // "they can't change people to/from admin. they can't add usage
    // credits. not settings." This function enforces the first of those
    // three server-side; the other two are enforced by simply never
    // granting Manager any rule elsewhere that would let them touch
    // orgs/{orgId}.credits or the settings doc.
    function managerRoleChangeValid() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && resource.data.role != "administrator"
        && request.resource.data.role in ["user", "manager"];
    }
    // Manager profile-edit scope (Aug 26 2026) — a SEPARATE allowance from
    // managerRoleChangeValid() above, matching AdminPage.jsx's existing
    // (and pre-existing, not new) Edit-name/social modal: saveEdit()
    // always writes fullName/socialAccounts/primarySocial/
    // secondarySocial/researchOrgIds regardless of role, and only
    // conditionally adds orgId/dailyLimitStanding/dailyLimitOverride*/
    // orgAdmin when `isAdmin` — those four inputs are already individually
    // `disabled={!isAdmin}` in the form itself (confirmed by direct code
    // read before writing this). This function completes that
    // already-half-built intent server-side rather than introducing a new
    // one: a Manager could always reach this modal for a non-admin target
    // once the routing/nav gaps elsewhere are fixed, and the ordinary
    // fields were never meant to be Administrator-only.
    function managerProfileEditValid() {
      let allowedFields = ['fullName', 'socialAccounts', 'primarySocial', 'secondarySocial', 'researchOrgIds'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedFields);
    }
    // ── users/{uid} ──────────────────────────────────────────────────────
    // Each person can read/create their own profile (registration, Google
    // sign-in first-time doc creation, AuthContext's own-profile read).
    // Admins can read everyone (Admin panel user list) and change role.
    // Nobody — including the owner — can change their OWN role, orgId, or
    // OWN rate-limit fields; only an admin can do that, and only on
    // someone else's doc.
    match /users/{uid} {
      // org-admin addition (August 2026): can read a specific member of
      // their OWN org (their "My Org" panel needs this), never a member of
      // a different org. isSameOrg-style comparison against the TARGET
      // doc's orgId, not the caller's — mirrors the pattern used everywhere
      // else in this file that scopes a Manager/org-admin action to "their
      // own org's stuff."
      allow get:    if isSignedIn() && (request.auth.uid == uid || isAdmin() || (isOrgAdmin() && resource.data.orgId == myOrgId()));
      // org-admin addition: list is allowed, but ONLY actually returns
      // results for an org admin when the client's query itself is scoped
      // to their own org (e.g. where("orgId","==",myOrgId())) — Firestore
      // evaluates this same per-document condition against every doc a
      // list query could return, so an unscoped query from an org admin
      // fails closed rather than silently returning nothing. The
      // AdminPage.jsx "My Org" panel always queries this way; see that
      // component for the actual query.
      // Manager addition (Aug 26 2026) — a plain Manager (role=="manager",
      // not also Administrator) previously satisfied NEITHER isAdmin() NOR
      // the org-admin clause here, so AdminPage.jsx's fetchUsers() —
      // completely unscoped — failed outright for every Manager, even
      // though the nav/UI (and this app's own Quick Reference doc) implied
      // Managers get real Admin panel access. Confirmed live via a real
      // Manager test account (Aug 26 2026): zero access, no Admin link
      // shown at all. Scoped to the Manager's own org — same isSameOrg()
      // boundary Manager already has everywhere else in this file (Storms
      // review, announcements) — not global the way isAdmin() is.
      allow list:   if isAdmin() || (isOrgAdmin() && resource.data.orgId == myOrgId()) || (isManager() && resource.data.orgId == myOrgId());
      // SECURITY FIX: previously this only required
      // `request.auth.uid == uid && role == "user"` — i.e. ANY successfully
      // authenticated Firebase user could write themselves a legitimate-
      // looking profile doc, regardless of whether they'd ever been
      // through the waitlist/invite flow at all. RegisterPage.jsx's
      // invite-token check (validate-token.mjs) runs entirely client-side
      // and only gates whether the React form renders — nothing stopped
      // someone from calling createUserWithEmailAndPassword() and this
      // create directly (browser console, or any Firebase client SDK),
      // since Firebase email/password sign-up itself has no invite
      // restriction. That meant unlimited free accounts, each getting a
      // real 50-call/day Claude budget — a "who gets in" gap AND a direct
      // cost-overrun vector. Now the create must reference a real,
      // still-"invited" waitlist doc with a matching email — something
      // only obtainable by actually being sent a real invite
      // (send-invite.mjs, Administrator-only, always assigns a
      // waitlistId — see that function). RegisterPage.jsx and LoginPage.jsx's
      // Google sign-in flow now both write `waitlistId` onto the profile
      // doc for exactly this reason.
      //
      // NOTE: this create rule does NOT require orgId to be set. New
      // accounts are created without an org today, same as every existing
      // account before this migration — org assignment happens via
      // scripts/migrate-users-to-orgs.mjs (Admin SDK) or a future
      // invite-time/admin flow, not at self-registration. Revisit once
      // org-aware invites are actually designed.
      allow create: if isSignedIn() && request.auth.uid == uid
                    && request.resource.data.role == "user" // can't self-assign a higher role
                    && !("orgId" in request.resource.data) // can't self-assign an org either
                    && referencesValidInvite();
      allow update: if isSignedIn() && (
                      // Owner may update their own profile fields, but never
                      // `role`, `orgId`, `orgAdmin`, or the rate-limit
                      // bookkeeping fields.
                      (request.auth.uid == uid && ownerProtectedFieldsUnchanged())
                      ||
                      // Admin may update anyone else's doc (role changes, edits)
                      (isAdmin() && request.auth.uid != uid)
                      ||
                      // org-admin addition (August 2026, TODO #1): may
                      // update a member of their OWN org, but never
                      // themselves via this branch (the owner branch above
                      // already covers their own doc, and still can't touch
                      // their own protected fields), never a DIFFERENT
                      // org's member, and never role/orgId/orgAdmin/
                      // dailyLimit* on anyone — ownerProtectedFieldsUnchanged()
                      // is reused here for exactly that field list, so
                      // there's one definition of "the fields nobody but a
                      // real Administrator may touch," not two. Additionally
                      // restricted to plain members: the TARGET must not
                      // already be a Manager/Administrator or another org
                      // admin — an org admin manages their org's rank-and-
                      // file, never staff or a peer org admin, closing off
                      // any lateral-privilege path between org admins.
                      (
                        isOrgAdmin()
                        && request.auth.uid != uid
                        && resource.data.orgId == myOrgId()
                        && resource.data.role == "user"
                        && resource.data.orgAdmin != true
                        && ownerProtectedFieldsUnchanged()
                      )
                      ||
                      // Manager addition (Aug 26 2026) — see
                      // managerRoleChangeValid()'s own comment for the
                      // exact scope. Same own-org boundary as the
                      // org-admin branch above (isSameOrg via myOrgId()),
                      // same "never touch your own doc through this
                      // branch" restriction.
                      (
                        isManager()
                        && request.auth.uid != uid
                        && resource.data.orgId == myOrgId()
                        && managerRoleChangeValid()
                      )
                      ||
                      // Manager profile-edit branch — see
                      // managerProfileEditValid()'s own comment. Same
                      // own-org boundary, and same "never an
                      // Administrator's doc" restriction as the role-change
                      // branch above, for consistency (an Administrator's
                      // row is fully locked in the UI, not just the role
                      // control on it).
                      (
                        isManager()
                        && request.auth.uid != uid
                        && resource.data.orgId == myOrgId()
                        && resource.data.role != "administrator"
                        && managerProfileEditValid()
                      )
                    );
      allow delete: if false; // deletions only happen via manage-user.mjs (Admin SDK, bypasses rules)
    }
    // ── waitlist/{doc} ───────────────────────────────────────────────────
    // Public form submission needs unauthenticated create.
    // The public "does this email already exist" (WaitlistPage.jsx) and
    // "is this Google account invited" (LoginPage.jsx) checks used to run
    // as direct client-side `list` queries with `limit(1)`. A `limit(1)`
    // allowance on `list` is enumerable: an attacker can page through the
    // entire waitlist one document at a time via repeated cursored
    // queries, extracting every applicant's name, email, organization,
    // and social handle. Both checks now go through server-side Netlify
    // functions (check-waitlist-email.mjs, check-waitlist-invite.mjs)
    // using the Admin SDK, which bypasses these rules entirely and
    // returns only the minimal fields each flow actually needs. `get` and
    // `list` are now admin-only — the only remaining client read path
    // (AdminPage.jsx's waitlist tab) is already gated behind isAdmin in
    // the UI, and this rule now enforces that server-side too.
    // Fixed July 2026 security pass.
    match /waitlist/{id} {
      // Manager addition (Aug 26 2026) — scoped to entries already tagged
      // with their own org. Waitlist entries only get an orgId field for
      // "org" account-type invites (send-invite.mjs) — an "individual"
      // track signup, or a pending doc from before an org was assigned,
      // has no orgId at all and so won't match this clause for anyone but
      // an Administrator. That's a deliberate fail-closed choice, not an
      // oversight: an org-less entry isn't really "this Manager's org's"
      // business yet.
      allow get:    if isAdmin() || (isManager() && resource.data.orgId == myOrgId());
      allow list:   if isAdmin() || (isManager() && resource.data.orgId == myOrgId());
      allow create: if request.resource.data.status == "pending"; // public signup always starts as pending
      // Tightened alongside the users/{uid} fix above: only the person
      // whose OWN verified email matches this waitlist entry can flip it
      // to "registered" — previously any signed-in user could flip ANY
      // invited-status waitlist doc, which (while not itself a way to gain
      // access) is a needless griefing surface now that this doc's status
      // is load-bearing for account creation.
      allow update: if isAdmin() ||
                      (isManager() && resource.data.orgId == myOrgId()) ||
                      // RegisterPage.jsx / LoginPage.jsx marking an invited entry "registered" after successful signup
                      (isSignedIn() &&
                        resource.data.status == "invited" &&
                        request.resource.data.status == "registered" &&
                        request.auth.token.email == resource.data.email);
      allow delete: if isAdmin();
    }
    // ── saved_campaigns/{doc} ────────────────────────────────────────────
    // Shared team Library — any logged-in coalition member can read, save,
    // or remove items. No public access. Matches LibraryPage.jsx's canDelete:
    // owner OR manager/admin can delete; there is no update path in the app.
    //
    // ORG-SCOPING (added August 2026, same decision as storms above):
    // Administrator can delete any entry, any org. A Manager can only
    // delete another user's entry within their OWN org (their own entries
    // are already covered by the owner-uid check regardless of org) — or
    // on a legacy entry with no orgId yet (fail-open, same reasoning as
    // storms: no disruptive backfill migration, self-heals as entries get
    // saved fresh with orgId going forward). orgId, if the client sets it
    // at save time, must match the saver's own org.
    match /saved_campaigns/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (!("orgId" in request.resource.data) || isSameOrg(request.resource.data.orgId));
      allow delete: if isSignedIn() &&
                      (
                        (("savedBy" in resource.data) && resource.data.savedBy != null && resource.data.savedBy.uid == request.auth.uid)
                        || isAdmin()
                        || (isManager() && (!("orgId" in resource.data) || isSameOrg(resource.data.orgId)))
                      );
      allow update: if false;
    }
    // ── saved_articles/{doc} ─────────────────────────────────────────────
    // Same org-scoping as saved_campaigns above — see that block's comment.
    match /saved_articles/{doc} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (!("orgId" in request.resource.data) || isSameOrg(request.resource.data.orgId));
      allow delete: if isSignedIn() &&
                      (
                        (("savedBy" in resource.data) && resource.data.savedBy != null && resource.data.savedBy.uid == request.auth.uid)
                        || isAdmin()
                        || (isManager() && (!("orgId" in resource.data) || isSameOrg(resource.data.orgId)))
                      );
      allow update: if false;
    }
    // ══════════════════════════════════════════════════════════════════
    // ▼▼▼  NEW — added for Storm Chasers Hub (July 2026)  ▼▼▼
    // ══════════════════════════════════════════════════════════════════
    // ── storms/{stormId} ─────────────────────────────────────────────────
    // Matches stormLibrary.js's canReview/canArchive (isManager — manager
    // OR administrator). Members can create (always forced to "draft")
    // and edit only their own draft; everything else requires Manager or
    // Administrator.
    //
    // ORG-SCOPING (added August 2026, same session as the Manager/Admin
    // permission-model decision): Administrator stays fully unrestricted,
    // any org, no change. A Manager may only edit/review storms belonging
    // to their OWN org. Storms had no orgId field at all before tonight —
    // rather than a disruptive backfill migration, this fails OPEN for any
    // storm that doesn't have orgId set yet (legacy content stays editable
    // by any Manager), and self-heals over time: orgId is validated on
    // create (must match the creator's own org if the client sets it) and
    // naturally gets backfilled the first time a Manager updates an old,
    // untagged storm. Once virtually all storms carry a real orgId, this
    // can be tightened to a hard requirement in a follow-up pass.
    match /storms/{stormId} {
      // Any signed-in coalition member can read all storms. The app's own
      // tab/filter UI is what limits what a Member sees by default; the
      // real security boundary here is on write, not read.
      allow read: if isSignedIn();
      // Create: must be creating as yourself. Non-staff members are
      // forced into "draft" regardless of what the client sends; Managers
      // and Admins may create with any status. orgId, if the client sets
      // it, must match the creator's own org — prevents self-tagging a
      // storm into an org you don't belong to.
      allow create: if isSignedIn()
        && request.resource.data.createdBy.uid == request.auth.uid
        && (!("orgId" in request.resource.data) || isSameOrg(request.resource.data.orgId))
        && (
          isManager()
          || request.resource.data.status == "draft"
        );
      // Update: Admins can change anything, any org, any time. Managers
      // can change anything but ONLY within their own org — or on legacy
      // storms that don't have orgId set yet (fail-open, see note above).
      // A Member may only edit their OWN storm, only while it is still a
      // draft, and only if it's STILL a draft after their edit — they
      // cannot use an update to move themselves into pending_review/
      // active; that transition only happens through the Manager/Admin-
      // gated path above.
      allow update: if isSignedIn() && (
        isAdmin()
        ||
        (
          isManager()
          && (!("orgId" in resource.data) || isSameOrg(resource.data.orgId))
        )
        ||
        (
          resource.data.createdBy.uid == request.auth.uid
          && resource.data.status == "draft"
          && request.resource.data.status == "draft"
        )
      );
      // Delete: administrators only. Managers archive instead of deleting
      // (matches canDelete in stormLibrary.js).
      allow delete: if isAdmin();
    }
    match /storms/{stormId}/posts/{postId} {
      allow read: if isSignedIn();
      // A storm's creator may only create/update/delete its posts while
      // the PARENT storm is still a draft. Previously this rule checked
      // only who the creator was, not the parent storm's status — so a
      // creator could keep editing posts inside a storm they had already
      // submitted for review (pending_review/active), bypassing the same
      // "locked once submitted" protection enforced on the
      // storms/{stormId} doc itself. Fixed July 2026 security pass.
      //
      // ORG-SCOPING (August 2026): same rule as the parent storm — Admin
      // unrestricted, Manager scoped to their own org (or fail-open on a
      // legacy storm with no orgId yet), checked against the PARENT
      // storm's orgId since posts don't carry their own.
      allow create, update, delete: if isSignedIn() && (
        isAdmin()
        || (
          isManager()
          && (
            !("orgId" in get(/databases/$(database)/documents/storms/$(stormId)).data)
            || isSameOrg(get(/databases/$(database)/documents/storms/$(stormId)).data.orgId)
          )
        )
        || (
          get(/databases/$(database)/documents/storms/$(stormId)).data.createdBy.uid == request.auth.uid
          && get(/databases/$(database)/documents/storms/$(stormId)).data.status == "draft"
        )
      );
    }
    // ══════════════════════════════════════════════════════════════════
    // ▲▲▲  END new storms block  ▲▲▲
    // ══════════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════════
    // ▼▼▼  NEW — added for Header Announcements (July 2026, Handoff #16 follow-up)  ▼▼▼
    // ══════════════════════════════════════════════════════════════════
    // ── announcements/{id} ───────────────────────────────────────────────
    // Matches announcementLibrary.js's canManageAnnouncements (isManager —
    // manager OR administrator). Any signed-in member needs read access
    // since AppShell.jsx polls this collection to show the header ticker
    // to everyone, not just staff. Only Manager/Admin can write.
    match /announcements/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isManager();
    }
    // ══════════════════════════════════════════════════════════════════
    // ▲▲▲  END new announcements block  ▲▲▲
    // ══════════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════════
    // ▼▼▼  NEW — added for Prompt Sandbox (July 2026, Handoff #26 follow-up)  ▼▼▼
    // ══════════════════════════════════════════════════════════════════
    // ── sandboxPresets/{uid}/presets/{presetId} ──────────────────────────
    // The Prompt Sandbox tool itself is Manager/Administrator-only (see
    // PromptSandboxPage.jsx's own isManager gate and
    // generate-sandbox-text.mjs's server-side role check). These rules
    // enforce the same boundary at the data layer, plus a stricter
    // ownership check: a preset lives under its owner's own uid segment,
    // and only that same signed-in uid may read, create, update, or
    // delete it — a Manager cannot read or edit a different Manager's
    // saved presets, even though both are equally privileged to use the
    // tool itself. request.auth.uid == uid is checked directly from the
    // path segment, so there's no need for a separate ownership field on
    // the document the way saved_campaigns/saved_articles use `savedBy`.
    match /sandboxPresets/{uid}/presets/{presetId} {
      allow read, create, update, delete: if isSignedIn()
        && request.auth.uid == uid
        && isManager();
    }
    // ══════════════════════════════════════════════════════════════════
    // ▲▲▲  END new sandboxPresets block  ▲▲▲
    // ══════════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════════
    // ▼▼▼  NEW — added for Candidates Firestore migration (August 2026, Handoff #29 follow-up)  ▼▼▼
    // ══════════════════════════════════════════════════════════════════
    // ── candidates/{candidateId} ─────────────────────────────────────────
    // Backs the Research tool's Search Candidates / Compare Races /
    // District Profiles tabs now that candidate data lives in Firestore
    // instead of being read live from Google Sheets (see
    // scripts/migrate-candidates-to-firestore.mjs and the updated
    // query-candidates.mjs). Doc IDs are deterministic slugs —
    // name-state-district for district races, name-state-office for
    // statewide races with no district (Governor, Attorney General,
    // Secretary of State, U.S. Senate) — but nothing in these rules
    // depends on that format; it's purely an application-level convention.
    //
    // Read: any signed-in coalition member. This is opposition-research
    // data (Strengths/Vulnerabilities/Key Quotes included), so it stays
    // behind sign-in the same way query-candidates.mjs already requires
    // an ID token — but every tool that currently consumes this data
    // (Research, Compare Races, District Profiles, Candidate Cards) is
    // used by every role, not just Managers/Admins, so read access
    // matches storms/announcements: isSignedIn(), not isManager().
    // NOT org-scoped as of this migration — candidates are treated as a
    // shared coalition-wide research resource, same as before org
    // identity existed. Revisit if that assumption changes.
    //
    // Write: Manager or Administrator only, matching who actually
    // maintains candidate data today (this mirrors the Prompt Sandbox and
    // Storm review gating, not a new judgment call). The bulk migration
    // script itself writes via the Firebase Admin SDK, which bypasses
    // these rules entirely — these rules only govern writes coming from
    // the app's own admin CRUD screen once that's built, or any other
    // signed-in client path. Delete is Administrator-only, same reasoning
    // as storms/{stormId}: a Manager mistake here is opposition-research
    // data loss, not something to make a single click away.
    //
    // focusOrgIds EXCEPTION (added August 2026, same session as the
    // Manager/Admin org-scoping decision): general candidate fields
    // (Fundraising, Notes, Strengths, etc.) stay open to any Manager,
    // regardless of org — candidates are shared coalition-wide research,
    // not owned by one org, so this is unchanged from the original design
    // above. focusOrgIds specifically is different: it's literally which
    // orgs get to claim this candidate as a priority, so a Manager may
    // only toggle their OWN org's membership in that array (see
    // focusOrgIdsChangeIsOwnOrgOnly() above) — never add or remove a
    // DIFFERENT org's entry. Administrators remain fully unrestricted.
    match /candidates/{candidateId} {
      allow read: if isSignedIn();
      allow create: if isManager() && (
        isAdmin()
        || !("focusOrgIds" in request.resource.data)
        || request.resource.data.focusOrgIds.hasOnly([myOrgId()])
      );
      allow update: if isManager() && (
        isAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["focusOrgIds"])
        || focusOrgIdsChangeIsOwnOrgOnly()
      );
      allow delete: if isAdmin();
    }
    // ══════════════════════════════════════════════════════════════════
    // ▲▲▲  END new candidates block  ▲▲▲
    // ══════════════════════════════════════════════════════════════════
    // ══════════════════════════════════════════════════════════════════
    // ▼▼▼  NEW — added for org identity (August 2026, priority-list item #1)  ▼▼▼
    // ══════════════════════════════════════════════════════════════════
    // ── orgs/{orgId} ──────────────────────────────────────────────────────
    // The foundational org record — name, addons (e.g. sandboxTranscription
    // from the transcription-metering design), and eventually credit
    // balances once the admin-granted-comp-credits and per-org metering
    // work is actually built. Seeded via scripts/migrate-users-to-orgs.mjs
    // (Admin SDK, bypasses these rules).
    //
    // Read: any member of that org (isSameOrg — a signed-in user whose own
    // users/{uid} doc has orgId == this doc's ID), or any global
    // administrator. A member reading their own org's doc is how the
    // client will show org name/addon status in the UI; there's no
    // legitimate reason for a user to read a DIFFERENT org's doc, so this
    // is deliberately narrower than candidates/storms/announcements,
    // which are shared coalition-wide resources — orgs are not.
    //
    // Write: administrator only, for all operations, for now. There is no
    // per-org "owner" or "org admin" role yet — every write (creating an
    // org, changing its name, flipping an addon, adjusting credit fields
    // once those exist) goes through a global Administrator. Revisit if/
    // when a per-org admin role gets designed.
    match /orgs/{orgId} {
      allow read: if isSameOrg(orgId) || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    // ── orgs/{orgId}/creditGrants/{grantId} ──────────────────────────────
    // Added alongside grant-credits.mjs (August 2026, admin-granted comp
    // credits — A.8 in the pricing/decisions report). An immutable
    // audit-trail entry per grant: amount, creditType, reason, who granted
    // it (server-set from the verified ID token, never client-supplied),
    // when. Read-only from the client — every write happens exclusively
    // through grant-credits.mjs's Admin SDK transaction, which bypasses
    // these rules entirely; `allow write: if false` here isn't a gap, it's
    // the point — there is no legitimate direct-client path to create,
    // edit, or delete a grant record.
    match /orgs/{orgId}/creditGrants/{grantId} {
      allow read: if isSameOrg(orgId) || isAdmin();
      allow write: if false;
    }
    // ── orgs/{orgId}/creditTransactions/{txnId} ──────────────────────────
    // Added alongside creditHelper.mjs's per-call ledger (August 22 2026).
    // One immutable doc per generation debit — credits, functionName
    // (which tool), uid, real token counts, timestamp — written inside the
    // same transaction as the generationBalance decrement, exclusively via
    // debitGenerationCredits()'s Admin SDK call, which bypasses these rules
    // entirely. Same access shape as creditGrants right above: any member
    // of the org can read their own org's usage history (this is what
    // finally lets a customer's credit-history question or a "when is
    // this account active" question actually get answered from the app
    // instead of nowhere), or a global Administrator. `allow write: if
    // false` isn't a gap — there is no legitimate direct-client path to
    // create, edit, or delete a ledger entry; it would defeat the point of
    // an audit trail.
    match /orgs/{orgId}/creditTransactions/{txnId} {
      allow read: if isSameOrg(orgId) || isAdmin();
      allow write: if false;
    }
    // ── transcriptionJobs/{jobId} ────────────────────────────────────────
    // Added alongside the transcription credit-metering wiring (August
    // 2026, closes out A.6). One doc per AssemblyAI job, written by
    // start-transcription.mjs at submission and updated by
    // check-transcription.mjs on billing — both via the Admin SDK, which
    // bypasses these rules entirely. Client access is read-only, scoped to
    // the submitting org (or a global admin) — there is no legitimate
    // direct-client write path; billing correctness depends on orgId and
    // billed being set exclusively by the server, never by whatever a
    // client happens to send.
    match /transcriptionJobs/{jobId} {
      allow read: if isSameOrg(resource.data.orgId) || isAdmin();
      allow write: if false;
    }
    // ── config/{id} ───────────────────────────────────────────────────────
    // Feature-flag-style settings docs, currently just
    // config/publicRegenerate — the manual kill-switch for
    // public-storm-regenerate.mjs (a public, unauthenticated, AI-cost-
    // incurring endpoint; see that function's own header comment). Found
    // missing entirely during an Aug 2026 security audit — the function
    // itself reads this fine via the Admin SDK (bypasses rules), but
    // AdminPage.jsx's own toggle UI writes it via the client SDK, which
    // was silently failing on every attempt with no rule at all
    // permitting the write. Scoped to isManager() (not isSignedIn()) —
    // this is a Manager/Admin-only control surface, matching
    // AdminPage.jsx's own tab gating, and there's no legitimate reason
    // for a plain Member to read or write it.
    match /config/{id} {
      allow read, write: if isManager();
    }
    // ── processedStripeEvents/{eventId} ──────────────────────────────────
    // Added alongside stripe-webhook.mjs (Aug 2026, individual-tier
    // build). Idempotency guard, doc ID = Stripe's own event.id — Stripe
    // explicitly documents at-least-once delivery (the same event can
    // arrive more than once on retry/redelivery), so this is what stops a
    // person's card being charged once but their account credited twice.
    // Written inside the SAME transaction as the actual credit grant.
    // Admin-SDK-only, same reasoning as orgs/{orgId}/creditGrants above —
    // `allow write: if false` here isn't a gap, it's the point: there is
    // no legitimate direct-client path to create, edit, or delete one of
    // these records. Read is Administrator-only (not isSameOrg-scoped
    // like creditGrants) since a processed-event record doesn't carry a
    // useful per-org read case the way a credit grant does.
    match /processedStripeEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    // ── generationJobs/{jobId} ────────────────────────────────────────────
    // Added alongside the Background Functions rearchitecture of Message
    // Machine's generateAll (August 2026, TODO #7 — the 26-second Netlify
    // timeout's real fix). start-message-generation.mjs creates the job
    // (Admin SDK), generate-message-background.mjs completes it (Admin SDK,
    // up to 15 minutes) — the client never writes here, only reads its own
    // job's status via a live listener while it's "pending", same
    // read-only-from-client shape as transcriptionJobs/{jobId}. Read scoped
    // to the job's own creator — a generation job can contain unpublished
    // draft campaign content, so this is narrower than transcriptionJobs's
    // org-wide read (which only ever holds a duration/billing record).
    match /generationJobs/{jobId} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }
    // ══════════════════════════════════════════════════════════════════
    // ▲▲▲  END new orgs block  ▲▲▲
    // ══════════════════════════════════════════════════════════════════
  }
}
